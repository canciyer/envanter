# Telegram token from @BotFather; do not commit real tokens
BOT_TOKEN=
# Optional local Bot API: e.g. http://127.0.0.1:8081 (needed for larger Telegram videos)
BOT_API_BASE=
# Maximum accepted size on disk (must also fit Telegram Bot API limits)
MAX_VIDEO_MB=512
# Custom emoji permitted only when bot meets Telegram requirements
ENABLE_CUSTOM_EMOJI=false
# Max simultaneous analyses
ANALYSIS_CONCURRENCY=2
CATALOG_PATH=data/catalog.json
PROFILE_PATH=config/inventory_profile.json
